# Upcraft Shopify — Environment Configuration Template
# Duplicate this file to .env and configure your Shopify credentials.
# NEVER commit your real .env file or access token to source control.

PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-secret-key-upcraft-2026

# Shopify Store Credentials (Admin GraphQL API 2026-10)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_REPLACE_WITH_REAL_TOKEN
SHOPIFY_API_VERSION=2026-10

# Cash on Delivery (COD) Rules
COD_MARKER_TYPE=TAG
COD_MARKER_VALUE=COD
COD_PAYMENT_GATEWAY_ID=

# Throttling & Queue Safety
MAX_BATCH_SIZE=70
RATE_LIMIT_DELAY_MS=400

# Set MOCK_MODE=true for local simulation without real Shopify credentials
MOCK_MODE=true

